page{background:#f7f7ef;color:#28392e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}.page{padding:32rpx 32rpx 56rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#64755e}.title{font-size:52rpx;font-weight:750;line-height:1.25;margin:18rpx 0}.sub{color:#778070;font-size:26rpx}.hero{position:relative;padding:40rpx 32rpx;background:#e6ecd8;border-radius:32rpx;margin:28rpx 0;overflow:hidden}.hero-art{font-size:100rpx;position:absolute;right:25rpx;bottom:24rpx;transform:rotate(-12deg)}.hero .title{max-width:460rpx}.hero .sub{max-width:420rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section{font-size:34rpx;font-weight:650;margin:32rpx 0 20rpx}.card{padding:28rpx;background:#fff;border-radius:24rpx;margin-bottom:22rpx;border:1rpx solid #e8eadd}.card-title{font-size:34rpx;font-weight:650;margin:16rpx 0 10rpx}.badge{font-size:22rpx;color:#365f43;background:#edf2e6;padding:5rpx 16rpx;border-radius:40rpx;display:inline-block}.muted-badge{background:#f5eedc;color:#7d683c}.meta{font-size:25rpx;color:#717b6b;margin:8rpx 0}.divider{height:1rpx;background:#edf0e5;margin:22rpx 0}.primary,.secondary{font-size:28rpx;border-radius:18rpx;padding:6rpx 24rpx;margin:20rpx 0 0;font-weight:600}.primary{background:#285b43;color:#fff}.secondary{background:#eaf0e1;color:#285b43}button::after{border:0}button[disabled]{background:#e3e6dd;color:#8b9185}.small{font-size:24rpx;padding:0 22rpx;margin:0;line-height:2.8}.filters{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.chip{font-size:24rpx;padding:12rpx 24rpx;background:#fff;border-radius:40rpx;border:1rpx solid #e0e5d7}.chip.active{background:#285b43;color:#fff;border-color:#285b43}.icon-tile{width:92rpx;height:92rpx;border-radius:24rpx;background:#f3eedc;display:flex;align-items:center;justify-content:center;font-size:50rpx}.notice{font-size:23rpx;padding:20rpx 24rpx;color:#7b725a;background:#f1eddf;border-radius:16rpx;margin:20rpx 0}.empty{text-align:center;padding:64rpx 28rpx}.empty-icon{font-size:80rpx}.field{margin:24rpx 0}.label{font-size:26rpx;font-weight:600;margin-bottom:12rpx}input,.picker,textarea{background:#f7f8f2;border:1rpx solid #e4e8dc;border-radius:14rpx;padding:20rpx;font-size:28rpx;width:100%;min-height:84rpx}textarea{height:180rpx}.half{flex:1;min-width:0}.agreement{font-size:25rpx;color:#626e5b;margin:28rpx 0}.big-icon{font-size:100rpx}.footer-note{font-size:22rpx;color:#909587;text-align:center;margin:30rpx 0}.link{color:#285b43;font-size:26rpx}.error{color:#a3432b;background:#fff0e9;padding:16rpx;border-radius:12rpx;margin:20rpx 0}

.title,.sub{white-space:pre-line}
