.detail-hero {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(156, 107, 54, 0.14);
  background: linear-gradient(145deg, #332a23 0%, #4d3b2d 100%);
}

.detail-title {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fffaf2;
  font-family: "Songti SC", serif;
}

.detail-subtitle {
  margin: 10rpx 0 18rpx;
  font-size: 26rpx;
  color: #c7b8a8;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(142, 123, 102, 0.12);
}

.booking-timeline {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(142, 123, 102, 0.12);
}

.timeline-item { width: 104rpx; text-align: center; color: #a39688; }
.timeline-dot { width: 18rpx; height: 18rpx; margin: 0 auto 10rpx; border-radius: 50%; background: #d9d0c6; }
.timeline-label { font-size: 21rpx; }
.timeline-item--active { color: #825a34; font-weight: 600; }
.timeline-item--active .timeline-dot { background: #9c6b36; box-shadow: 0 0 0 7rpx rgba(156, 107, 54, .1); }
.timeline-line { flex: 1; height: 2rpx; margin-top: 8rpx; background: #ddd4ca; }
.timeline-line--active { background: #b98550; }

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a7b6d;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  line-height: 1.5;
  color: #2f2b27;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-button {
  flex: 1;
}

.danger-action { color: #a64f3d; border-color: rgba(166, 79, 61, .3); }
