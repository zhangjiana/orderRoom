<view class="page">
  <view wx:if="{{loading}}" class="empty-card">正在加载订单...</view>

  <view wx:if="{{!loading && errorMessage}}" class="empty-card">
    <view>{{errorMessage}}</view>
    <view>历史未绑定账号的订单，请联系商家处理。</view>
    <button class="primary-button" bindtap="loadBooking">重试</button>
  </view>

  <block wx:if="{{!loading && booking}}">
    <view class="detail-hero">
      <view class="section-kicker">BOOKING</view>
      <view class="detail-title">{{booking.merchantName}}</view>
      <view class="detail-subtitle">{{booking.roomName}} · {{booking.status}}</view>
      <view class="status-pill {{booking.statusClass}}">{{booking.status}}</view>
    </view>

    <view class="form-card">
      <view
        class="booking-timeline"
        wx:if="{{booking.rawStatus !== 'cancelled' && booking.rawStatus !== 'rejected'}}"
      >
        <view class="timeline-item timeline-item--active">
          <view class="timeline-dot"></view><view class="timeline-label">已提交</view>
        </view>
        <view class="timeline-line {{booking.timelineStep >= 2 ? 'timeline-line--active' : ''}}"></view>
        <view class="timeline-item {{booking.timelineStep >= 2 ? 'timeline-item--active' : ''}}">
          <view class="timeline-dot"></view><view class="timeline-label">已确认</view>
        </view>
        <view class="timeline-line {{booking.timelineStep >= 3 ? 'timeline-line--active' : ''}}"></view>
        <view class="timeline-item {{booking.timelineStep >= 3 ? 'timeline-item--active' : ''}}">
          <view class="timeline-dot"></view><view class="timeline-label">已完成</view>
        </view>
      </view>
      <view class="info-row">
        <view class="info-label">用餐时间</view>
        <view class="info-value">{{booking.date}} {{booking.time}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">用餐人数</view>
        <view class="info-value">{{booking.guests}} 位</view>
      </view>
      <view class="info-row">
        <view class="info-label">宴请场合</view>
        <view class="info-value">{{booking.occasion}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">联系人</view>
        <view class="info-value">{{booking.contactName}} · {{booking.phone}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">预算</view>
        <view class="info-value">¥{{booking.budget}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">门店地址</view>
        <view class="info-value">{{booking.merchantAddress}}</view>
      </view>
      <view class="info-row" wx:if="{{booking.remarks}}">
        <view class="info-label">备注</view>
        <view class="info-value">{{booking.remarks}}</view>
      </view>
    </view>

    <view class="detail-actions">
      <button
        class="primary-button action-button"
        wx:if="{{booking.rawStatus === 'confirmed' || booking.rawStatus === 'completed'}}"
        bindtap="openInvitation"
      >生成邀请函</button>
      <button
        class="secondary-button action-button"
        wx:if="{{booking.merchantLatitude && booking.merchantLongitude}}"
        bindtap="openLocation"
      >导航到门店</button>
      <button
        class="secondary-button action-button danger-action"
        wx:if="{{booking.rawStatus === 'pending' || booking.rawStatus === 'confirmed'}}"
        bindtap="cancelBooking"
      >取消预订</button>
    </view>
  </block>
</view>
