<view class="page">
  <view class="discovery-hero">
    <view class="hero-eyebrow">PRIVATE DINING</view>
    <view class="hero-title">好席，值得提前安排</view>
    <view class="hero-copy">精选城市包间，为重要的一餐留出体面与从容。</view>
    <view class="location-bar">
      <view class="location-dot"></view>
      <view class="location-text" wx:if="{{cityName}}">{{cityName}} · 附近优选</view>
      <view class="location-text location-text--hint" wx:else>开启定位，发现附近好店</view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-icon">⌕</view>
    <input
      class="search-input"
      placeholder-class="field-placeholder"
      placeholder="搜索餐厅或商圈"
      value="{{keyword}}"
      bindinput="handleKeyword"
      confirm-type="search"
      bindconfirm="searchMerchants"
    />
    <button class="search-btn" bindtap="searchMerchants">搜索</button>
  </view>

  <view class="list-heading" wx:if="{{!loading}}">
    <view class="list-title">为你精选</view>
    <view class="list-count">{{merchants.length}} 家</view>
  </view>
  <view wx:if="{{loading}}" class="empty-card">正在获取商家...</view>

  <block wx:if="{{!loading && merchants.length}}">
    <view
      class="merchant-card"
      wx:for="{{merchants}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openMerchant"
    >
      <view class="merchant-card__accent"></view>
      <view class="merchant-card__header">
        <view>
          <view class="merchant-card__label">宴请优选</view>
          <view class="merchant-card__name">{{item.name}}</view>
        </view>
        <view class="merchant-card__distance" wx:if="{{item.distanceText}}">{{item.distanceText}}</view>
      </view>
      <view class="merchant-card__info">
        <text>{{item.roomSummary}}</text>
        <text class="merchant-card__dot">·</text>
        <text>{{item.businessHours}}</text>
      </view>
      <view class="merchant-card__tags" wx:if="{{item.featuredTags.length}}">
        <view
          class="merchant-card__tag"
          wx:for="{{item.featuredTags}}"
          wx:for-item="tag"
          wx:key="*this"
        >{{tag}}</view>
      </view>
      <view class="merchant-card__footer">
        <view>查看包间详情</view><view class="merchant-card__arrow">→</view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !merchants.length}}" class="empty-card">
    暂无符合条件的商家，试试换个关键词
  </view>
</view>
