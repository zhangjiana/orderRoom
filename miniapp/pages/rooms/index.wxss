.discovery-hero {
  padding: 32rpx 4rpx 30rpx;
}

.hero-eyebrow {
  color: #9c6b36;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.22em;
}

.hero-title {
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #25211d;
}

.hero-copy {
  max-width: 620rpx;
  margin-top: 14rpx;
  color: #75695e;
  font-size: 25rpx;
  line-height: 1.65;
}

.location-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.location-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #a46d39;
  box-shadow: 0 0 0 8rpx rgba(164, 109, 57, 0.1);
}

.location-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b241d;
}

.location-text--hint {
  font-weight: 400;
  color: #8a7b6d;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 8rpx 8rpx 8rpx 22rpx;
  border: 1rpx solid rgba(110, 83, 58, 0.1);
  border-radius: 18rpx;
  background: #fffefb;
  box-shadow: 0 10rpx 30rpx rgba(64, 45, 29, 0.06);
}

.search-icon { color: #9c8d7d; font-size: 34rpx; }

.search-input {
  flex: 1;
  padding: 18rpx 8rpx;
  border: none;
  background: transparent;
  font-size: 28rpx;
  color: #2f2b27;
}

.search-btn {
  width: 140rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1;
  padding: 22rpx 0;
  font-weight: 600;
  background: #8b5e34;
  color: #ffffff;
}

.search-btn::after {
  border: none;
}

.list-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 18rpx; }
.list-title { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 700; }
.list-count { color: #9a8b7d; font-size: 23rpx; }

.merchant-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(115, 91, 61, 0.08);
  background: #fffefb;
  box-shadow: 0 10rpx 30rpx rgba(64, 45, 29, 0.055);
}

.merchant-card:active { transform: scale(0.99); opacity: 0.92; }
.merchant-card__accent { position: absolute; top: 0; left: 0; width: 8rpx; height: 100%; background: #a87543; }
.merchant-card__label { margin-bottom: 6rpx; color: #a87543; font-size: 20rpx; font-weight: 600; letter-spacing: 0.12em; }

.merchant-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-card__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #29241e;
}

.merchant-card__distance {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8e5d2a;
  font-weight: 600;
}

.merchant-card__info {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #857768;
  line-height: 1.6;
}

.merchant-card__dot {
  margin: 0 8rpx;
}

.merchant-card__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.merchant-card__footer { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(115,91,61,.08); color: #6d5d4f; font-size: 23rpx; }
.merchant-card__arrow { color: #9c6b36; font-size: 28rpx; }

.merchant-card__tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #efe3d2;
  color: #825f3c;
  font-size: 22rpx;
}
