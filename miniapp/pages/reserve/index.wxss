.selected-room-info {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #332a23 0%, #4d3b2d 100%);
  border: 1rpx solid rgba(156, 107, 54, 0.15);
  margin-bottom: 24rpx;
}
.selected-room-info__kicker { color: #d6b78f; font-size: 19rpx; font-weight: 700; letter-spacing: .18em; }

.selected-room-info__merchant {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: #c7b8a8;
}

.selected-room-info__room {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fffaf2;
  font-family: "Songti SC", serif;
}

.selected-room-info__price {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #e3c49d;
  font-weight: 600;
}

.submit-section {
  margin-top: 36rpx;
}
.form-intro { margin-top: 10rpx; color: #897a6b; font-size: 24rpx; line-height: 1.6; }
.submit-note { margin-top: 16rpx; color: #9a8c7f; font-size: 21rpx; line-height: 1.5; text-align: center; }
